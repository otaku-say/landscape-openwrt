#!/bin/sh
# The value must never appear in shell tracing, argv, UCI, or image build args.
set +x
set -eu
fail() { printf 'landscape-password: %s\n' "$*" >&2; exit 1; }
password=${LAND_ROOT_PASSWORD:-}
[ -n "$password" ] || fail 'Set LAND_ROOT_PASSWORD in Compose before starting.'
[ "$password" != CHANGE_ME_BEFORE_START ] || fail 'Replace the example LAND_ROOT_PASSWORD.'
cr=$(printf '\r')
case "$password" in *'
'*|*"$cr"*) fail 'LAND_ROOT_PASSWORD cannot contain CR or LF.' ;; esac
printf 'root:%s\n' "$password" | chpasswd -c SHA512 >/dev/null
unset password LAND_ROOT_PASSWORD
