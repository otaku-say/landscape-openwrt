#!/bin/sh
# shellcheck shell=ash
# OpenWrt's UCI shell library intentionally reads unset optional variables.
set -e
. /lib/functions.sh

# These are namespace-local. Do not run OpenWrt's host-wide sysctl tuning.
sysctl -qw net.ipv4.ip_forward=1 net.ipv6.conf.all.forwarding=1 \
    net.ipv4.conf.all.rp_filter=0 net.ipv4.conf.default.rp_filter=0 \
    net.ipv4.conf.eth0.rp_filter=0 net.ipv4.conf.lo.accept_local=1 \
    net.ipv4.conf.all.send_redirects=0 net.ipv4.conf.default.send_redirects=0 \
    net.ipv4.conf.eth0.send_redirects=0 \
    net.ipv6.conf.all.disable_ipv6=0 net.ipv6.conf.eth0.disable_ipv6=0

# Keep upstream include sections, since PassWall and OpenClash install theirs at boot.
set_zone() {
    local section="$1" name
    config_get name "$section" name
    [ "$name" = lan ] || return 0
    uci set "firewall.$section.input=ACCEPT"
    uci set "firewall.$section.output=ACCEPT"
    uci set "firewall.$section.forward=ACCEPT"
    uci set "firewall.$section.masq=1"
    uci set "firewall.$section.masq6=1"
    uci set "firewall.$section.mtu_fix=1"
}
config_load firewall
config_foreach set_zone zone
uci set 'firewall.@defaults[0].flow_offloading=0'
uci set 'firewall.@defaults[0].flow_offloading_hw=0'
uci set 'firewall.@defaults[0].fullcone=0'
uci set 'firewall.@defaults[0].fullcone6=0'
uci commit firewall

stop_dhcp() {
    local section="$1"
    uci set "dhcp.$section.ignore=1"
    uci set "dhcp.$section.ra=disabled"
    uci set "dhcp.$section.dhcpv6=disabled"
    uci set "dhcp.$section.ndp=disabled"
}
config_load dhcp
config_foreach stop_dhcp dhcp
if [ "$(uci -q get landscape.container.initialized || true)" != 1 ]; then
    uci set 'dhcp.@dnsmasq[0].noresolv=1'
    uci set 'dhcp.@dnsmasq[0].localservice=0'
    uci -q delete 'dhcp.@dnsmasq[0].server' || true
    uci add_list "dhcp.@dnsmasq[0].server=$(uci get landscape.container.dns)"
    uci set landscape.container.initialized=1
    uci commit landscape
fi
uci commit dhcp
for service in odhcpd turboacc sysntpd sysfixtime sysctl autocore autoreboot; do
    [ ! -x "/etc/init.d/$service" ] || "/etc/init.d/$service" disable
done
# First-boot defaults may have enabled these flags again.
if uci -q get turboacc.config >/dev/null; then
    uci set turboacc.config.sfe_flow=0
    uci set turboacc.config.hw_flow=0
    uci set turboacc.config.fullcone_nat=0
    uci commit turboacc
fi
touch /tmp/landscape-prepared
