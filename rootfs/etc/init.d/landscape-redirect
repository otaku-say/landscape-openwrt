#!/bin/sh /etc/rc.common
START=99
STOP=01
USE_PROCD=1

start_service() {
    [ -f /tmp/landscape-prepared ] || {
        logger -t landscape-redirect 'Network preparation failed; refusing to register this exit.'
        return 1
    }
    local level capture=1
    level="$(uci -q get landscape.container.log_level || true)"
    level=${level:-ERROR}
    case "$level" in
        OFF) capture=0 ;;
        ERROR|WARN|INFO|DEBUG|TRACE) ;;
        *) logger -p daemon.err -t landscape-redirect 'Invalid log level; refusing to start.'; return 1 ;;
    esac
    local icmp_on icmp_mark proxy_saddr proxy_saddr6 proxy_sport proxy_mode proxy_sock_path
    icmp_on="$(uci -q get landscape.container.icmp_passthrough || true)"
    icmp_on=${icmp_on:-true}
    icmp_mark="$(uci -q get landscape.container.icmp_mark || true)"
    icmp_mark=${icmp_mark:-2}
    proxy_saddr="$(uci -q get landscape.container.proxy_server_addr || true)"
    proxy_saddr=${proxy_saddr:-0.0.0.0}
    proxy_saddr6="$(uci -q get landscape.container.proxy_server_addr_v6 || true)"
    proxy_saddr6=${proxy_saddr6:-::}
    proxy_sport="$(uci -q get landscape.container.proxy_server_port || true)"
    proxy_sport=${proxy_sport:-12345}
    proxy_mode="$(uci -q get landscape.container.proxy_handle_mode || true)"
    proxy_mode=${proxy_mode:-route}
    proxy_sock_path="$(uci -q get landscape.container.sock_path || true)"
    proxy_sock_path=${proxy_sock_path:-/ld_unix_link}

    procd_open_instance
    procd_set_param env         LAND_PROXY_SERVER_ADDR="$proxy_saddr"         LAND_PROXY_SERVER_ADDR_V6="$proxy_saddr6"         LAND_PROXY_SERVER_PORT="$proxy_sport"         LAND_PROXY_HANDLE_MODE="$proxy_mode"         LAND_PROXY_ENABLE_ICMP_PASSTHROUGH="$icmp_on"         LAND_PROXY_ICMP_MARK_VALUE="$icmp_mark"         LAND_SOCK_PATH="$proxy_sock_path"         LAND_REDIRECT_LOG_LEVEL="$level"
    if [ "$icmp_on" = true ]; then
        procd_set_param command /usr/bin/redirect_pkg_handler             --saddr "$proxy_saddr"             --saddr6 "$proxy_saddr6"             --sport "$proxy_sport"             --mode "$proxy_mode"             --sock_path "$proxy_sock_path"             --log-level "$level"             --enable-icmp-passthrough             --icmp-mark-value "$icmp_mark"
    else
        procd_set_param command /usr/bin/redirect_pkg_handler             --saddr "$proxy_saddr"             --saddr6 "$proxy_saddr6"             --sport "$proxy_sport"             --mode "$proxy_mode"             --sock_path "$proxy_sock_path"             --log-level "$level"
    fi
    procd_set_param respawn 3600 5 0
    # The handler writes tracing errors to stdout; OFF also silences unfiltered stderr.
    procd_set_param stdout "$capture"
    procd_set_param stderr "$capture"
    procd_set_param limits memlock="unlimited unlimited"
    procd_close_instance
}
